# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor. La usa el webhook de MercadoPago para escribir el estado
# del pago sin sesión de usuario. Supabase > Settings > API > service_role.
# NUNCA exponerla con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Solo para correr migraciones desde la terminal (psql). La app no la usa.
# Supabase > Connect > Shared pooler. Si la contraseña tiene caracteres
# especiales, hay que percent-encodearlos.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASEÑA@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# MercadoPago (Checkout Pro)
# https://www.mercadopago.com.ar/developers/panel/app
# ---------------------------------------------------------------------
# Credenciales de prueba: TEST-xxxx | Producción: APP_USR-xxxx
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Panel de MercadoPago > Tus integraciones > Webhooks > "Clave secreta".
# Sin esto el webhook acepta notificaciones sin validar la firma.
MP_WEBHOOK_SECRET=

# Clave pública, la única credencial de MercadoPago que puede viajar al
# navegador. La usa el SDK de front-end para renderizar el botón oficial.
# Tiene que ser de la MISMA cuenta que el MP_ACCESS_TOKEN de arriba.
# Sin ella el checkout sigue andando, pero por redirección y sin botón oficial.
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# Integrator ID del Programa de Partners de MercadoPago. Identifica quién
# hizo la integración y da acceso a los beneficios del programa. Viaja como
# header X-Integrator-Id en todas las llamadas. No es un secreto.
MP_INTEGRATOR_ID=dev_0000000000000000000000000000000

# Tienda: el pago sale aprobado o rechazado, nunca queda "en proceso".
# Poner en false para aceptar pagos pendientes. No afecta a las señas.
MP_BINARY_MODE=true

# Tope de cuotas que ofrece el checkout de la tienda (default 12, máx 24).
MP_MAX_INSTALLMENTS=12

# ---------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------
# URL pública, usada para las back_urls y el notification_url de MercadoPago.
# En producción tiene que ser HTTPS (MercadoPago rechaza auto_return sin él).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Reglas de cobro
# ---------------------------------------------------------------------
# Porcentaje del total que se cobra como seña (default: 30).
NEXT_PUBLIC_DEPOSIT_PERCENTAGE=30

# Minutos que se reserva el horario esperando el pago (default: 30).
# Vencido el plazo, el turno se cancela y el horario se libera.
NEXT_PUBLIC_PAYMENT_HOLD_MINUTES=30
